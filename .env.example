# Server
PORT=8080

# Comma-separated provider IDs.
# Balance-based API relays: right-code, micu, timicc, packy
# Subscription meters (rate-limit windows / traffic quotas, no balance):
# claude, gpt, v2free
PROVIDERS=right-code,micu,timicc,packy,gpt,claude,v2free

# Right Code provider
# Required: user token from localStorage.userToken after signing in at https://www.right.codes
RIGHT_CODE_AUTH_TOKEN=
# Optional: multiply cost by this factor (e.g., if costs are in CNY, use 0.14 for USD conversion)
RIGHT_CODE_COST_MULTIPLIER=1
# Optional: override provider ID in response
RIGHT_CODE_PROVIDER_ID=right-code

# Micu provider
# Required: access token generated at https://www.micuapi.ai/console
MICU_AUTH_TOKEN=
# Required: numeric user id (run `JSON.parse(localStorage.user).id` in the console)
MICU_USER_ID=
# Optional: override provider ID in response
MICU_PROVIDER_ID=micu

# TimiCC provider
# Required: a non-expiring API key (sk-...) from the timicc.com console
# (Settings > API Keys / 令牌). Balance + usage are read from /v1/usage.
# TIMICC_AUTH_TOKEN is accepted as a fallback name for the same value.
TIMICC_API_KEY=
# Optional: override provider ID in response
TIMICC_PROVIDER_ID=timicc

# Packy provider
# Required: access token generated at https://www.packyapi.com/console
PACKY_AUTH_TOKEN=
# Required: numeric user id (run `JSON.parse(localStorage.user).id` in the console)
PACKY_USER_ID=
# Optional: override provider ID in response
PACKY_PROVIDER_ID=packy
# Optional: Packy quota units per USD (defaults to 500000 if omitted)
PACKY_QUOTA_TO_USD=

# Claude subscription meter
# No token and no request: Claude Code caches the usage payload to disk as it
# runs, and the server reads that file. Meters are stamped "as of <time>".
# Optional: override the cache file (default $CLAUDE_CONFIG_DIR/cache/usage-utilization.json)
CLAUDE_USAGE_CACHE_PATH=
# Optional: override the config dir the cache and credentials live under
CLAUDE_CONFIG_DIR=
# Optional: credentials file, fallback for the plan label (current tier is
# read from ~/.claude.json oauthAccount, which tracks plan changes)
CLAUDE_CREDENTIALS_PATH=
# Optional: override provider ID in response
CLAUDE_PROVIDER_ID=claude
#
# Cost line on the Claude card: Claude Code's own totalCostUSD (what /cost
# reports), summed over sessions active in the window. A flat-rate plan bills
# nothing per token, so it is what the usage would have cost at API rates.
# Cumulative per session, so a long session counts days outside the window --
# per-day attribution is not possible from these records.
# Optional: days of session activity to include (default 7)
CLAUDE_COST_WINDOW_DAYS=
# Optional: set false to hide the cost line
CLAUDE_SHOW_COST=
# Optional: override the transcript directory (default $CLAUDE_CONFIG_DIR/projects)
CLAUDE_PROJECTS_DIR=
#
# DO NOT SET THIS. `network` calls api.anthropic.com/api/oauth/usage directly --
# a non-public endpoint whose polling from this dashboard got the account
# banned. Nothing falls back to it; it exists only because the code path does.
CLAUDE_USAGE_SOURCE=
# Only used when CLAUDE_USAGE_SOURCE=network:
CLAUDE_OAUTH_TOKEN=

# GPT (Codex) subscription meter
# No token needed: the server runs the local `codex` binary as an app server and
# asks it for the account rate limits, so the binary makes the request with its
# own credentials. The dashboard never calls chatgpt.com itself.
# Optional: pin the codex binary (else PATH, ~/.vscode/extensions/openai.chatgpt-*,
# then ~/.local/bin)
CODEX_BIN=
# Optional: override provider ID in response
GPT_PROVIDER_ID=gpt
#
# Offline fallback -- the snapshot Codex last wrote to disk. Only advances when a
# Codex turn runs locally, so these meters are stamped "as of <time>".
# Optional: override the session directory (default $CODEX_HOME/sessions)
GPT_SESSIONS_DIR=
# Optional: how many recent session files to scan (default 10)
GPT_SESSION_SCAN_LIMIT=
#
# Source override. Unset = app server, then disk fallback.
#   local   = read disk snapshots only, never run the binary
#   network = call chatgpt.com/backend-api/codex/usage directly. It sits behind a
#             Cloudflare challenge and returns 403 HTML from a challenged
#             network; there is no automatic fallback onto it. Same
#             non-public-endpoint caution as `claude` applies.
GPT_USAGE_SOURCE=
# Only used when GPT_USAGE_SOURCE=network:
# Optional: point at a specific credentials JSON file
GPT_AUTH_FILE=
# Optional: supply the ChatGPT access token directly
GPT_ACCESS_TOKEN=
# Optional: ChatGPT account id, sent as the chatgpt-account-id header
GPT_ACCOUNT_ID=
# Optional: override the usage endpoint if your client uses a different one
GPT_USAGE_URL=

# V2Free traffic meter
# Reads the session cookie maintained by ~/Documents/scripts/v2free_fetch.py
# and scrapes https://v2free.org/user. When the session has expired it runs
# that script to re-login (the site's bot gate needs its Chrome impersonation),
# then retries once.
# Optional: cookie file (default ~/.config/clash/v2free.cookie)
V2FREE_COOKIE_FILE=
# Optional: command that refreshes the cookie
# (default: ~/.venv/bin/python ~/Documents/scripts/v2free_fetch.py /dev/null)
V2FREE_REFRESH_CMD=
# Optional: override provider ID in response
V2FREE_PROVIDER_ID=v2free

# Outbound proxy. Also handed down to the codex binary, which reaches
# chatgpt.com itself and inherits nothing from the shell under systemd.
# Falls back to HTTPS_PROXY / https_proxy / ALL_PROXY, and honours NO_PROXY.
SUBSCRIPTION_PROXY_URL=
